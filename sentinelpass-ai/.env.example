# Copy to .env and edit. NEVER commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///data/sentinelpass.db

# Password hashing (PBKDF2-HMAC-SHA256). Higher = slower for attackers AND for your logins.
PASSWORD_HASH_ITERATIONS=600000
PASSWORD_HISTORY_COUNT=5

# Account protection (durations are in MINUTES)
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION=15
RESET_TOKEN_EXPIRY=10
SESSION_EXPIRY=30

# AI: local (default, no network) | anthropic | openai
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=

# Optional: scikit-learn IsolationForest anomaly signal (pip install scikit-learn)
ENABLE_ML_ANOMALY=false
